---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { getPosts } from "../../lib/payload";

const currentLocale = Astro.currentLocale || "de";

// Fetch published posts from Payload API
const posts = await getPosts({ locale: currentLocale, limit: 12 });
---

<BaseLayout title="Travel Journal - Micklas Travels" locale={currentLocale}>
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<div class="max-w-6xl mx-auto px-6 py-24">
		<div class="text-center mb-16">
			<div class="inline-block px-4 py-1 bg-brand-teal/10 text-brand-teal text-sm tracking-[3px] mb-4">
				TRAVEL JOURNAL
			</div>
			<h1 class="text-6xl font-bold tracking-tight mb-6">Stories from the Road</h1>
			<p class="text-xl text-gray-600 max-w-lg mx-auto">
				Behind-the-scenes moments, travel tips, and honest reflections from my journeys around the world.
			</p>
		</div>

		{posts.length === 0 ? (
			<div class="text-center py-20">
				<p class="text-gray-500">
					No published stories yet. Check back soon!
				</p>
			</div>
		) : (
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map((post) => (
					<a
						href={`/${currentLocale}/journal/${post.slug}`}
						class="group block overflow-hidden rounded-3xl border border-gray-100 hover:shadow-2xl transition-all duration-500"
					>
						<div class="relative h-80 bg-gradient-to-br from-brand-navy/60 to-brand-navy">
							{post.coverImage && (
								<img
									src={post.coverImage.url}
									alt={post.title}
									class="absolute inset-0 w-full h-full object-cover"
								/>
							)}
							<div class="absolute inset-0 bg-gradient-to-b from-black/20 to-black/70"></div>
							<div class="absolute bottom-6 left-6 right-6 text-white">
								<div class="text-sm opacity-75 mb-2">
									{new Date(post.publishDate).toLocaleDateString(currentLocale)}
								</div>
								<h3 class="text-3xl font-semibold leading-tight group-hover:text-brand-teal transition-colors">
									{post.title}
								</h3>
							</div>
						</div>
						<div class="p-8">
							<p class="text-gray-600 line-clamp-3 text-[15px] leading-relaxed">
								{post.excerpt}
							</p>
							<div class="mt-6 flex items-center text-brand-teal font-medium group-hover:underline">
								Read the full story &rarr;
							</div>
						</div>
					</a>
				))}
			</div>
		)}
	</div>
</BaseLayout>
