---
import { getLocaleStaticPaths } from "../../i18n/locales";

export async function getStaticPaths() {
	return getLocaleStaticPaths();
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { t, getLocale } from "../../i18n/translations";
import { getCollection } from "astro:content";

const currentLocale = Astro.currentLocale || "de";
const tr = (key: string) => t(key, getLocale(currentLocale));

// Fetch published journal posts for the current locale
const allPosts = await getCollection("journal", ({ data }) => {
	return data.locale === currentLocale && data.draft === false;
});

const posts = allPosts.sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout title="Travel Journal - Micklas Travels" locale={currentLocale} description={"Travel journal by Micklas — behind-the-scenes stories, photography tips, and reflections from journeys around the world."}>
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<div class="max-w-6xl mx-auto px-6 py-24">
		<div class="text-center mb-16">
			<div class="inline-block px-4 py-1 bg-secondary/10 text-secondary text-sm tracking-[3px] mb-4">
				{tr("journal.badge")}
			</div>
			<h1 class="font-headline-xl text-headline-xl mb-6">{tr("journal.title")}</h1>
			<p class="text-xl text-on-surface-variant max-w-2xl mx-auto">
				{tr("journal.subtitle")}
			</p>
		</div>

		{posts.length === 0 ? (
			<div class="text-center py-20">
				<p class="text-on-surface-variant">{tr("journal.empty")}</p>
			</div>
		) : (
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map((post) => (
					<a
						href={`/${currentLocale}/journal/${post.data.slug}`}
						class="group block overflow-hidden rounded-3xl border border-outline-variant/20 hover:shadow-xl transition-all duration-500"
					>
						<div class="relative h-80 bg-gradient-to-br from-primary-container/60 from-primary-container">
							{post.data.coverImage && (
								<img
									src={post.data.coverImage}
									alt={post.data.title}
									class="absolute inset-0 w-full h-full object-cover"
								/>
							)}
							<div class="absolute inset-0 bg-gradient-to-b from-black/20 to-black/70"></div>
							<div class="absolute bottom-6 left-6 right-6 text-white">
								<div class="text-sm opacity-75 mb-2">
									{post.data.publishDate.toLocaleDateString(currentLocale)}
								</div>
								<h3 class="text-3xl font-semibold leading-tight group-hover:text-secondary transition-colors">
									{post.data.title}
								</h3>
							</div>
						</div>
						<div class="p-8">
							<p class="text-on-surface-variant line-clamp-3 text-[15px] leading-relaxed">
								{post.data.excerpt}
							</p>
							<div class="mt-6 flex items-center text-secondary font-medium group-hover:underline">
								{tr("journal.read")}
							</div>
						</div>
					</a>
				))}
			</div>
		)}
	</div>
</BaseLayout>
