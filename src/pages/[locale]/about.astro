---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { t, getLocale } from "../../i18n/translations";

const currentLocale = Astro.currentLocale || "de";
const _ = (key: string) => t(key, getLocale(currentLocale));
---

<BaseLayout title="About Micklas" locale={currentLocale}>
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<div class="max-w-5xl mx-auto px-6 py-24">
		<div class="text-center mb-16 reveal">
			<div class="inline-block px-4 py-1 bg-brand-teal/10 text-brand-teal text-sm tracking-[3px] mb-4">
				{_("about.badge")}
			</div>
			<h1 class="text-7xl font-bold tracking-tighter mb-6">{_("about.title")}</h1>
			<p class="text-2xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
				{_("about.subtitle")}
			</p>
		</div>

		<div class="grid md:grid-cols-5 gap-16 items-start">
			<div class="md:col-span-2">
				<div class="sticky top-28 reveal">
					<div class="aspect-[3/4] bg-gradient-to-br from-brand-teal/20 to-brand-navy/20 rounded-3xl flex items-center justify-center">
						<img src="/logo-micklas.svg" alt="Micklas" class="w-48 h-48" />
					</div>
				</div>
			</div>

			<div class="md:col-span-3 space-y-8 text-lg leading-relaxed text-gray-700">
				<p class="reveal" set:html={_("about.p1")}></p>
				<p class="reveal">{_("about.p2")}</p>
				<p class="reveal">{_("about.p3")}</p>

				<div class="grid grid-cols-3 gap-6 py-8 border-y border-gray-200 reveal">
					<div class="text-center">
						<div class="text-4xl font-bold text-brand-teal">40+</div>
						<div class="text-sm text-gray-500 mt-1">{_("about.stats.countries")}</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-brand-teal">120k</div>
						<div class="text-sm text-gray-500 mt-1">{_("about.stats.followers")}</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-brand-teal">10</div>
						<div class="text-sm text-gray-500 mt-1">{_("about.stats.languages")}</div>
					</div>
				</div>

				<p class="text-gray-500 italic reveal">{_("about.p4")}</p>

				<div class="pt-4 reveal">
					<a
						href={`/${currentLocale}/collaborate`}
						class="inline-block bg-brand-teal hover:bg-brand-navy text-white text-lg px-10 py-4 rounded-full font-medium transition-all"
					>
						{_("about.cta")}
					</a>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
