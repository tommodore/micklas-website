---
import { getLocaleStaticPaths } from "../../i18n/locales";

export async function getStaticPaths() {
	return getLocaleStaticPaths();
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { t, getLocale } from "../../i18n/translations";

const currentLocale = Astro.currentLocale || "de";
const tr = (key: string) => t(key, getLocale(currentLocale));
---

<BaseLayout title="About Micklas" locale={currentLocale} description={"Travel photographer Michael Glashauser (@micklas) — 120k+ followers, 40+ countries. Professional travel photography and brand collaborations."}>amp; brand collaborations.">
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<div class="max-w-5xl mx-auto px-margin-mobile md:px-margin-desktop py-xxl">
		<div class="text-center mb-xl reveal">
			<div class="inline-flex items-center gap-2 mb-sm">
				<span class="w-8 h-px bg-secondary"></span>
				<span class="font-label-bold text-label-bold text-secondary uppercase tracking-widest">{tr("about.badge")}</span>
				<span class="w-8 h-px bg-secondary"></span>
			</div>
			<h1 class="font-headline-xl text-headline-xl text-on-surface mb-sm">{tr("about.title")}</h1>
			<p class="font-body-xl text-body-xl text-on-surface-variant max-w-3xl mx-auto">{tr("about.subtitle")}</p>
		</div>

		<div class="grid md:grid-cols-5 gap-xl items-start">
			<div class="md:col-span-2">
				<div class="sticky top-28 reveal">
					<div class="aspect-[3/4] bg-gradient-to-br from-secondary/20 to-primary-container/20 rounded-xl flex items-center justify-center">
						<img src="/logo-micklas.jpg" alt="Micklas" class="w-48 h-48 rounded-full ring-4 ring-surface-container-highest/30" />
					</div>
				</div>
			</div>

			<div class="md:col-span-3 space-y-lg">
				<p class="font-body-xl text-body-xl text-on-surface-variant leading-relaxed reveal" set:html={tr("about.p1")}></p>
				<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed reveal">{tr("about.p2")}</p>
				<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed reveal">{tr("about.p3")}</p>

				<div class="grid grid-cols-3 gap-gutter py-lg border-y border-outline-variant/20 reveal">
					<div class="text-center">
						<div class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-secondary">40+</div>
						<div class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mt-xs">{tr("about.stats.countries")}</div>
					</div>
					<div class="text-center">
						<div class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-secondary">120k</div>
						<div class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mt-xs">{tr("about.stats.followers")}</div>
					</div>
					<div class="text-center">
						<div class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-secondary">10</div>
						<div class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mt-xs">{tr("about.stats.languages")}</div>
					</div>
				</div>

				<p class="font-body-md text-body-md text-tertiary italic leading-relaxed reveal">{tr("about.p4")}</p>

				<div class="pt-sm reveal">
					<a
						href={`/${currentLocale}/collaborate`}
						class="inline-flex items-center gap-2 bg-secondary text-on-secondary font-label-bold text-label-bold uppercase px-8 py-4 rounded-lg hover:brightness-110 transition-all duration-300 shadow-lg shadow-secondary/20"
					>
						{tr("about.cta")}
						<span class="material-symbols-outlined text-lg">arrow_forward</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
