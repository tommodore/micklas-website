---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";

const currentLocale = Astro.currentLocale || "de";
---

<BaseLayout title="About Micklas" locale={currentLocale}>
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<div class="max-w-5xl mx-auto px-6 py-24">
		<div class="text-center mb-16">
			<div class="inline-block px-4 py-1 bg-brand-teal/10 text-brand-teal text-sm tracking-[3px] mb-4">
				ABOUT
			</div>
			<h1 class="text-7xl font-bold tracking-tighter mb-6">Micklas Travels</h1>
			<p class="text-2xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
				Travel photographer, storyteller, and creator with a passion for authentic experiences and epic landscapes.
			</p>
		</div>

		<div class="grid md:grid-cols-5 gap-16 items-start">
			<div class="md:col-span-2">
				<div class="sticky top-28">
					<div class="aspect-[3/4] bg-gradient-to-br from-brand-teal/20 to-brand-navy/20 rounded-3xl flex items-center justify-center">
						<img src="/logo-micklas.svg" alt="Micklas" class="w-48 h-48" />
					</div>
				</div>
			</div>

			<div class="md:col-span-3 space-y-8 text-lg leading-relaxed text-gray-700">
				<p>
					Hi, I'm Michael &mdash; known as <strong>Micklas</strong> to my 120k+ Instagram community. 
					I'm a travel photographer and content creator who has explored over 40 countries across 
					every continent.
				</p>

				<p>
					My work lives at the intersection of adventure and aesthetics. From the midnight sun 
					of the Lofoten Islands to the ancient medinas of Morocco, I capture the world as I 
					see it &mdash; honest, dramatic, and full of wonder.
				</p>

				<p>
					Beyond creating content for my own platforms, I partner with tourism boards, hotels, 
					and lifestyle brands to create visual stories that resonate with modern travelers. 
					My photography has been featured in campaigns across Europe, South America, and Asia.
				</p>

				<div class="grid grid-cols-3 gap-6 py-8 border-y border-gray-200">
					<div class="text-center">
						<div class="text-4xl font-bold text-brand-teal">40+</div>
						<div class="text-sm text-gray-500 mt-1">Countries</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-brand-teal">120k</div>
						<div class="text-sm text-gray-500 mt-1">Followers</div>
					</div>
					<div class="text-center">
						<div class="text-4xl font-bold text-brand-teal">10</div>
						<div class="text-sm text-gray-500 mt-1">Languages</div>
					</div>
				</div>

				<p class="text-gray-500 italic">
					"Every photograph tells a story &mdash; but the best ones invite you to become part of it. 
					Whether through my lens or through a partnership, I'm here to make those stories unforgettable."
				</p>

				<div class="pt-4">
					<a
						href={`/${currentLocale}/collaborate`}
						class="inline-block bg-brand-teal hover:bg-brand-navy text-white text-lg px-10 py-4 rounded-full font-medium transition-all"
					>
						Work with Micklas
					</a>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
