---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../../components/LanguageSwitcher.astro";
import { t, getLocale } from "../../../i18n/translations";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const allPosts = await getCollection("journal", ({ data }) => data.draft === false);
	return allPosts.map((post) => ({
		params: { slug: post.data.slug, locale: post.data.locale },
		props: { post },
	}));
}

const { post } = Astro.props;
const currentLocale = post.data.locale;
const tr = (key: string) => t(key, getLocale(currentLocale));
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} - Micklas Travels Journal`} locale={currentLocale}>
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<article class="max-w-3xl mx-auto px-6 py-24">
		<a
			href={`/${currentLocale}/journal`}
			class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-brand-teal mb-12 transition-colors"
		>
			&larr; {tr("journal.back")}
		</a>

		<header class="mb-12">
			<div class="inline-block px-4 py-1 bg-brand-teal/10 text-brand-teal text-sm tracking-[3px] mb-6">
				{post.data.publishDate.toLocaleDateString(currentLocale)}
			</div>
			<h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 leading-tight">
				{post.data.title}
			</h1>
			{post.data.excerpt && (
				<p class="text-xl text-gray-600 leading-relaxed">{post.data.excerpt}</p>
			)}
			{post.data.tags && (
				<div class="flex flex-wrap gap-2 mt-6">
					{post.data.tags.map((tag: string) => (
						<span class="bg-brand-teal/10 text-brand-teal text-xs px-4 py-1.5 rounded-full font-medium">{tag}</span>
					))}
				</div>
			)}
		</header>

		{post.data.coverImage && (
			<div class="mb-16 rounded-3xl overflow-hidden">
				<img
					src={post.data.coverImage}
					alt={post.data.title}
					class="w-full h-auto"
					width="1200"
					height="800"
				/>
			</div>
		)}

		<div class="prose prose-lg max-w-none prose-headings:text-brand-navy prose-a:text-brand-teal prose-img:rounded-2xl">
			<Content />
		</div>

		<div class="mt-20 pt-12 border-t border-gray-200 text-center">
			<p class="text-lg text-gray-600 mb-6">Enjoyed this story?</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a
					href={`/${currentLocale}/journal`}
					class="inline-block bg-gray-100 hover:bg-gray-200 text-brand-navy px-8 py-3 rounded-full font-medium transition-all"
				>
					More Stories
				</a>
				<a
					href={`/${currentLocale}/collaborate`}
					class="inline-block bg-brand-teal hover:bg-brand-navy text-white px-8 py-3 rounded-full font-medium transition-all"
				>
					Work with Micklas
				</a>
			</div>
		</div>
	</article>
</BaseLayout>
