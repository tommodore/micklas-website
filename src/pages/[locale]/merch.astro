---
import { getLocaleStaticPaths } from "../../i18n/locales";

export async function getStaticPaths() {
	return getLocaleStaticPaths();
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { t, getLocale } from "../../i18n/translations";

const currentLocale = Astro.currentLocale || "de";
const tr = (key: string) => t(key, getLocale(currentLocale));
---

<BaseLayout title="Merchandise Shop - Micklas Travels" locale={currentLocale} description={"Official Micklas Travels merchandise — exclusive collections for adventurers and travel enthusiasts."}>
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<div class="max-w-5xl mx-auto px-margin-mobile md:px-margin-desktop py-xxl text-center reveal">
		<div class="inline-flex items-center gap-2 mb-sm">
			<span class="w-8 h-px bg-secondary"></span>
			<span class="font-label-bold text-label-bold text-secondary uppercase tracking-widest">SHOP</span>
			<span class="w-8 h-px bg-secondary"></span>
		</div>

		<h1 class="font-headline-xl text-headline-xl text-on-surface mb-sm">{tr("merch.title")}</h1>
		<p class="font-body-xl text-body-xl text-on-surface-variant max-w-2xl mx-auto mb-xl">{tr("merch.subtitle")}</p>

		<div class="glass-panel rounded-xl p-xl max-w-2xl mx-auto">
			<span class="material-symbols-outlined text-6xl text-secondary mb-md">shopping_bag</span>
			<h2 class="font-headline-lg text-headline-lg text-on-surface mb-sm">Coming Soon</h2>
			<p class="font-body-md text-body-md text-on-surface-variant mb-lg">Der offizielle Micklas Merchandise Shop ist in Vorbereitung. T-Shirts, Caps und mehr – exklusiv für die Community.</p>
			<a
				href={`/${currentLocale}/collaborate`}
				class="inline-flex items-center gap-2 bg-secondary text-on-secondary font-label-bold text-label-bold uppercase px-8 py-4 rounded-lg hover:brightness-110 transition-all shadow-lg shadow-secondary/20"
			>
				{tr("merch.cta")}
				<span class="material-symbols-outlined text-lg">arrow_forward</span>
			</a>
		</div>
	</div>
</BaseLayout>
