---
import { getLocaleStaticPaths } from "../../i18n/locales";

export async function getStaticPaths() {
	return getLocaleStaticPaths();
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import Hero from "../../components/Hero.astro";
import StatsBar from "../../components/StatsBar.astro";
import FeaturedTravels from "../../components/FeaturedTravels.astro";
import Testimonials from "../../components/Testimonials.astro";
import InstagramFeed from "../../components/InstagramFeed.astro";
import CTASection from "../../components/CTASection.astro";

const currentLocale = Astro.currentLocale || "de";
---

<BaseLayout title="Home - Micklas Travels" locale={currentLocale} description={"Micklas Travels — Travel Photography by Michael Glashauser. 120k+ Instagram community. Travel influencer and social media advertising partner."}>
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<Hero locale={currentLocale} />
	<StatsBar locale={currentLocale} />
	<FeaturedTravels locale={currentLocale} />
	<Testimonials locale={currentLocale} />
	<InstagramFeed locale={currentLocale} />
	<CTASection locale={currentLocale} />
</BaseLayout>
