---
import { getLocaleStaticPaths } from "../../i18n/locales";

export async function getStaticPaths() {
	return getLocaleStaticPaths();
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { t, getLocale } from "../../i18n/translations";

const currentLocale = Astro.currentLocale || "de";
const tr = (key: string) => t(key, getLocale(currentLocale));

const destinations = [
	{
		id: 1,
		slug: "lofoten-norway",
		title: "Lofoten Islands",
		country: "Norway",
		region: "Europe",
		year: "2026",
		description: "Dramatic peaks rising from the sea during the midnight sun.",
		tags: ["Mountains", "Midnight Sun"],
	},
	{
		id: 2,
		slug: "patagonia-chile",
		title: "Torres del Paine",
		country: "Chile",
		region: "South America",
		year: "2026",
		description: "Epic granite towers and endless wilderness in Patagonia.",
		tags: ["Hiking", "Wilderness"],
	},
	{
		id: 3,
		slug: "iceland-winter",
		title: "Iceland Winter",
		country: "Iceland",
		region: "Europe",
		year: "2025",
		description: "Northern Lights and ice caves in the land of fire and ice.",
		tags: ["Northern Lights", "Winter"],
	},
	{
		id: 4,
		slug: "new-zealand",
		title: "South Island",
		country: "New Zealand",
		region: "Oceania",
		year: "2025",
		description: "Milford Sound and the Southern Alps at their most dramatic.",
		tags: ["Fjords", "Mountains"],
	},
	{
		id: 5,
		slug: "morocco-desert",
		title: "Sahara Desert",
		country: "Morocco",
		region: "Africa",
		year: "2024",
		description: "Golden dunes and ancient kasbahs under endless starry skies.",
		tags: ["Desert", "Culture"],
	},
	{
		id: 6,
		slug: "japan-autumn",
		title: "Kyoto & Alps",
		country: "Japan",
		region: "Asia",
		year: "2024",
		description: "Autumn colors in Kyoto and the Japanese Alps.",
		tags: ["Culture", "Autumn"],
	},
];

const regions = ["All", "Europe", "South America", "Oceania", "Africa", "Asia"];
const years = ["All", ...new Set(destinations.map((d) => d.year))];
---

<BaseLayout title="Travels - Micklas Travels" locale={currentLocale} description={"Explore Micklas travel photography portfolio — stunning landscapes from Lofoten, Patagonia, Iceland, Japan, and more."}>
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-xxl" id="travels-page" data-regions={JSON.stringify(regions)} data-years={JSON.stringify(years)} data-destinations={JSON.stringify(destinations)} data-locale={currentLocale} data-empty-text={tr("travels.empty")}>
		{/* Header */}
		<div class="text-center mb-xl">
			<div class="inline-flex items-center gap-2 mb-sm">
				<span class="w-8 h-px bg-secondary"></span>
				<span class="font-label-bold text-label-bold text-secondary uppercase tracking-widest">{tr("travels.badge")}</span>
				<span class="w-8 h-px bg-secondary"></span>
			</div>
			<h1 class="font-headline-xl text-headline-xl text-on-surface mb-sm">{tr("travels.title")}</h1>
			<p class="font-body-xl text-body-xl text-on-surface-variant max-w-2xl mx-auto">{tr("travels.subtitle")}</p>
		</div>

		{/* Filters */}
		<div class="flex flex-col md:flex-row gap-4 mb-xl sticky top-20 bg-surface/95 backdrop-blur-lg py-lg z-40 border-b border-outline-variant/10">
			<div class="flex flex-wrap gap-2" id="region-filters">
				{regions.map((region) => (
					<button
						class={`font-label-bold text-label-bold uppercase px-5 py-2 rounded-full transition-all filter-btn region-btn ${
							region === "All" ? "bg-secondary text-on-secondary" : "bg-surface-container-high text-on-surface-variant hover:bg-surface-container-highest hover:text-on-surface"
						}`}
						data-region={region}
					>
						{region === "All" ? tr("travels.filter.all") : region}
					</button>
				))}
			</div>
			<div class="flex flex-wrap gap-2 md:ml-auto" id="year-filters">
				{years.map((year) => (
					<button
						class={`font-label-bold text-label-bold uppercase px-5 py-2 rounded-full transition-all filter-btn year-btn ${
							year === "All" ? "bg-secondary text-on-secondary" : "bg-surface-container-high text-on-surface-variant hover:bg-surface-container-highest hover:text-on-surface"
						}`}
						data-year={year}
					>
						{year === "All" ? tr("travels.filter.all") : year}
					</button>
				))}
			</div>
		</div>

		{/* Portfolio Grid */}
		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-gutter" id="travels-grid">
			{destinations.map((dest) => (
				<div
					class="destination-card group rounded-xl overflow-hidden border border-outline-variant/20 hover:shadow-lg transition-all duration-500"
					data-region={dest.region}
					data-year={dest.year}
				>
					<a href={`/${currentLocale}/travels/${dest.slug}`} class="block">
						<div class="relative aspect-[4/5] bg-gradient-to-br from-primary-container/80 to-primary-container overflow-hidden">
							<div class="absolute inset-0 cinematic-overlay"></div>
							<div class="absolute top-4 left-4 flex gap-2">
								<span class="bg-surface/80 text-on-surface text-label-sm uppercase tracking-wider px-3 py-1 rounded-full font-medium backdrop-blur-sm">
									{dest.country}
								</span>
								<span class="bg-surface/80 text-on-surface text-label-sm uppercase tracking-wider px-3 py-1 rounded-full font-medium backdrop-blur-sm">
									{dest.year}
								</span>
							</div>
							<div class="absolute bottom-6 left-6 right-6">
								<h3 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-white mb-2 group-hover:text-secondary transition-colors">
									{dest.title}
								</h3>
								<p class="font-body-md text-body-md text-on-surface-variant line-clamp-2 mb-3 opacity-90">{dest.description}</p>
								<div class="flex flex-wrap gap-2">
									{dest.tags.map((tag) => (
										<span class="font-label-sm text-label-sm text-white bg-white/10 px-3 py-1 rounded-full backdrop-blur-sm">{tag}</span>
									))}
								</div>
							</div>
						</div>
					</a>
				</div>
			))}
		</div>

		{/* Footer */}
		<div class="text-center mt-xl font-body-md text-body-md text-on-surface-variant">
			{tr("travels.footer")}
		</div>
	</div>
</BaseLayout>

<script>
	let activeRegion = "All";
	let activeYear = "All";

	function updateFilters() {
		const cards = document.querySelectorAll<HTMLElement>(".destination-card");
		let visibleCount = 0;

		cards.forEach((card) => {
			const region = card.dataset.region;
			const year = card.dataset.year;
			const regionMatch = activeRegion === "All" || region === activeRegion;
			const yearMatch = activeYear === "All" || year === activeYear;

			if (regionMatch && yearMatch) {
				card.style.display = "block";
				visibleCount++;
			} else {
				card.style.display = "none";
			}
		});

		let emptyState = document.getElementById("empty-state");
		if (visibleCount === 0) {
			if (!emptyState) {
				emptyState = document.createElement("div");
				emptyState.id = "empty-state";
				emptyState.className = "text-center py-xxl text-on-surface-variant col-span-full font-body-md text-body-md";
				emptyState.textContent = document.getElementById("travels-page")!.dataset.emptyText || "No destinations found.";
				document.getElementById("travels-grid")!.appendChild(emptyState);
			}
			emptyState.style.display = "block";
		} else if (emptyState) {
			emptyState.style.display = "none";
		}
	}

	// Region buttons
	document.querySelectorAll(".region-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			document.querySelectorAll(".region-btn").forEach((b) => {
				b.classList.remove("bg-secondary", "text-on-secondary");
				b.classList.add("bg-surface-container-high", "text-on-surface-variant");
			});
			btn.classList.add("bg-secondary", "text-on-secondary");
			btn.classList.remove("bg-surface-container-high", "text-on-surface-variant");
			activeRegion = (btn as HTMLElement).dataset.region!;
			updateFilters();
		});
	});

	// Year buttons
	document.querySelectorAll(".year-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			document.querySelectorAll(".year-btn").forEach((b) => {
				b.classList.remove("bg-secondary", "text-on-secondary");
				b.classList.add("bg-surface-container-high", "text-on-surface-variant");
			});
			btn.classList.add("bg-secondary", "text-on-secondary");
			btn.classList.remove("bg-surface-container-high", "text-on-surface-variant");
			activeYear = (btn as HTMLElement).dataset.year!;
			updateFilters();
		});
	});
</script>
