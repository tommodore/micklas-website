---
import { getLocaleStaticPaths } from "../../i18n/locales";

export async function getStaticPaths() {
	return getLocaleStaticPaths();
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import CollaborateForm from "../../components/CollaborateForm";

const currentLocale = Astro.currentLocale || "de";
---

<BaseLayout title="Collaborate - Micklas Travels" locale={currentLocale} description={"Partner with Micklas for travel photography, social media advertising and brand collaborations. Tourism boards, hotels and lifestyle brands."}>amp; brand collaborations. Tourism boards, hotels locale={currentLocale} description={"Partner with Micklas for travel photography, social media advertising and brand collaborations. Tourism boards, hotels and lifestyle brands."}>amp; lifestyle brands.">
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<div class="max-w-3xl mx-auto px-6 py-24">
		<div class="text-center mb-16">
			<div class="inline-block px-4 py-1 bg-secondary/10 text-secondary text-sm tracking-[3px] mb-4">
				LET'S CREATE SOMETHING GREAT
			</div>
			<h1 class="font-headline-xl text-headline-xl mb-6">Collaborate with Micklas</h1>
			<p class="text-xl text-on-surface-variant max-w-lg mx-auto">
				Whether you're a brand, tourism board, hotel, or agency &mdash; we'd love to hear from you.
			</p>
		</div>

		<CollaborateForm locale={currentLocale} client:load />
	</div>
</BaseLayout>
