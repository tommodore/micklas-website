---
import { getLocaleStaticPaths } from "../../i18n/locales";

export async function getStaticPaths() {
	return getLocaleStaticPaths();
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import CollaborateForm from "../../components/CollaborateForm";

const currentLocale = Astro.currentLocale || "de";
---

<BaseLayout title="Collaborate - Micklas Travels" locale={currentLocale}>
	<Fragment slot="language-switcher">
		<LanguageSwitcher />
	</Fragment>

	<div class="max-w-3xl mx-auto px-6 py-24">
		<div class="text-center mb-16">
			<div class="inline-block px-4 py-1 bg-brand-teal/10 text-brand-teal text-sm tracking-[3px] mb-4">
				LET'S CREATE SOMETHING GREAT
			</div>
			<h1 class="text-6xl font-bold tracking-tight mb-6">Collaborate with Micklas</h1>
			<p class="text-xl text-gray-600 max-w-lg mx-auto">
				Whether you're a brand, tourism board, hotel, or agency &mdash; we'd love to hear from you.
			</p>
		</div>

		<CollaborateForm locale={currentLocale} client:load />
	</div>
</BaseLayout>
