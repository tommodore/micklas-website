---
// The Payload CMS backend is deployed separately as a Cloudflare Worker.
// Once you have a custom domain, set PUBLIC_PAYLOAD_URL in Pages env vars
// and this page will redirect to your Payload admin.
//
// For now, deploy Payload with: bash deploy-payload.sh
// and update PUBLIC_PAYLOAD_URL with its Workers URL.

const adminUrl = import.meta.env.PUBLIC_PAYLOAD_URL
	? `${import.meta.env.PUBLIC_PAYLOAD_URL}/admin`
	: null;

if (adminUrl) {
	return Astro.redirect(adminUrl, 307);
}
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Admin - Micklas Travels</title>
		<style>
			body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f5f5; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
			.card { background: white; padding: 3rem; border-radius: 1rem; box-shadow: 0 4px 24px rgba(0,0,0,0.1); text-align: center; max-width: 420px; }
			h1 { color: #142A64; font-size: 1.5rem; margin-bottom: 0.5rem; }
			p { color: #666; line-height: 1.6; margin-bottom: 1.5rem; }
			code { background: #f0f0f0; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem; }
		</style>
	</head>
	<body>
		<div class="card">
			<img src="/logo-micklas.jpg" alt="Micklas" style="width:80px;height:80px;border-radius:50%;margin-bottom:1rem" />
			<h1>CMS Admin Panel</h1>
			<p>
				The Payload CMS backend is deployed separately.<br />
				<strong>To access the admin panel:</strong>
			</p>
			<p style="font-size:0.9rem;text-align:left;background:#f9f9f9;padding:1rem;border-radius:8px">
				1. Deploy Payload:<br />
				<code>bash deploy-payload.sh</code><br /><br />
				2. Set <code>PUBLIC_PAYLOAD_URL</code><br />
				in your Pages env vars<br /><br />
				3. Refresh this page
			</p>
			<p style="font-size:0.85rem;color:#999">
				Or visit your Payload Worker URL directly
			</p>
		</div>
	</body>
</html>
