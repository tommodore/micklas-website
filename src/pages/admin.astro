---
// Decap CMS admin panel
// Log in with your GitHub account to manage content.
// Content changes are committed to the repo and auto-deployed to Pages.
---
<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Content Manager - Micklas Travels</title>
		<style>
			body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f5f5; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
			.card { background: white; padding: 3rem; border-radius: 1rem; box-shadow: 0 4px 24px rgba(0,0,0,0.1); text-align: center; max-width: 420px; }
			.btn { display: inline-block; background: #30BB9A; color: white; padding: 0.75rem 2rem; border-radius: 999px; text-decoration: none; font-weight: 600; margin-top: 1rem; }
			.btn:hover { background: #142A64; }
		</style>
	</head>
	<body>
		<div class="card">
			<img src="/logo-micklas.jpg" alt="Micklas" style="width:80px;height:80px;border-radius:50%;margin-bottom:1rem" />
			<h1 style="color:#142A64;margin-bottom:0.5rem">Content Manager</h1>
			<p style="color:#666;margin-bottom:1.5rem">Manage travel journal posts, photos, and more.</p>
			<a class="btn" href="/admin/">Open Admin Panel</a>
			<p style="font-size:0.85rem;color:#999;margin-top:1.5rem">
				Changes are saved directly to GitHub.<br />
				Pages auto-deploys on every save.
			</p>
		</div>
	</body>
</html>
