---
import { t, getLocale } from "../i18n/translations";
import { getAllLocales } from "../i18n/locales";

export interface Props {
	title: string;
	description?: string;
	locale?: string;
}

const { title, description } = Astro.props;
const currentLocale = Astro.currentLocale || "de";
const tr = (key: string) => t(key, getLocale(currentLocale));
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/[a-z]{2}/, "");
const hreflangLocales = getAllLocales();
---

<!doctype html>
<html class="dark" lang={currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description || "Micklas Travels — Travel Photography by Michael Glashauser. 120k+ Instagram community. Partner for Social Media Advertising."} />
		<meta name="theme-color" content="#121317" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" href="/logo-micklas.jpg" />

		{/* Google Fonts: Playfair Display (600,700), Inter (400,500,600), Material Symbols Outlined */}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
			rel="stylesheet"
		/>

		<!-- Open Graph / Social -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title + " | Micklas Travels"} />
		<meta property="og:description" content={description || "Micklas Travels — Travel Photography by Michael Glashauser. 120k+ Instagram community."} />
		<meta property="og:image" content="https://micklas-website.pages.dev/logo-micklas.jpg" />
		<meta property="og:url" content={"https://micklas-website.pages.dev" + Astro.url.pathname} />
		<meta property="og:locale" content={currentLocale === "de" ? "de_DE" : currentLocale === "en" ? "en_US" : currentLocale === "fr" ? "fr_FR" : currentLocale === "it" ? "it_IT" : currentLocale === "es" ? "es_ES" : currentLocale === "pt" ? "pt_PT" : currentLocale === "da" ? "da_DK" : currentLocale === "sv" ? "sv_SE" : currentLocale === "no" ? "nb_NO" : "me_ME"} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title + " | Micklas Travels"} />
		<meta name="twitter:description" content={description || "Micklas Travels — Travel Photography by Michael Glashauser."} />
		<meta name="twitter:image" content="https://micklas-website.pages.dev/logo-micklas.jpg" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={"https://micklas-website.pages.dev" + Astro.url.pathname} />
		
		<!-- Hreflang for all 10 locales -->
		{hreflangLocales.map((l) => (
			<link rel="alternate" hreflang={l} href={`https://micklas-website.pages.dev/${l}${cleanPath}`} />
		))}
		<link rel="alternate" hreflang="x-default" href="https://micklas-website.pages.dev" />
		
		<!-- JSON-LD Structured Data: Person -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Michael Glashauser",
			"alternateName": "Micklas",
			"url": "https://micklas-website.pages.dev",
			"image": "https://micklas-website.pages.dev/logo-micklas.jpg",
			"sameAs": [
				"https://www.instagram.com/_micklas_/",
				"https://micklastravels.jimdofree.com/"
			],
			"jobTitle": "Travel Photographer & Content Creator",
			"description": "Travel photographer and content creator with 120k+ Instagram community."
		}
		</script>
		
		<!-- JSON-LD Structured Data: WebSite -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "Micklas Travels",
			"url": "https://micklas-website.pages.dev",
			"description": "Travel Photography by Michael Glashauser. 120k+ Instagram community. Partner for Social Media Advertising.",
			"inLanguage": ["de", "en", "fr", "it", "es", "pt", "da", "sv", "no", "me"]
		}
		</script>
		
		<!-- Cloudflare Web Analytics (privacy-friendly, no cookies) -->
		<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "YOUR_CLOUDFLARE_TOKEN"}'></script>

		<title>{title} | Micklas Travels</title>
		<slot name="head" />
	</head>
	<body class="bg-background text-on-surface text-body-md font-body antialiased min-h-screen flex flex-col">
		{/* ==============================
					FIXED TOP HEADER — Glass Panel
		============================== */}
		<header class="fixed top-0 left-0 right-0 z-50 glass-panel h-20">
			<div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop h-full flex items-center justify-between">
				{/* Left: Logo + Brand */}
				<a href={`/${currentLocale}/`} class="flex items-center gap-3 group">
					<img
						src="/logo-micklas.jpg"
						alt="Micklas Travels"
						class="h-10 w-10 rounded-full ring-2 ring-surface-container-highest/50 group-hover:ring-secondary/50 transition-all duration-300"
					/>
					<span class="hidden sm:block font-heading text-headline-lg-mobile md:text-headline-lg text-on-surface font-semibold tracking-tight">
						Micklas Travels
					</span>
				</a>

				{/* Center: Desktop Navigation */}
				<nav class="hidden md:flex items-center gap-8">
					<a
						href={`/${currentLocale}/travels`}
						class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300"
					>
						{tr("nav.travels")}
					</a>
					<a
						href={`/${currentLocale}/journal`}
						class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300"
					>
						{tr("nav.journal")}
					</a>
					<a
						href={`/${currentLocale}/about`}
						class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300"
					>
						{tr("nav.about")}
					</a>
					<a
						href={`/${currentLocale}/collaborate`}
						class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300"
					>
						{tr("nav.collaborate")}
					</a>
					<a
						href={`/${currentLocale}/merch`}
						class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300"
					>
						{tr("nav.merch")}
					</a>
				</nav>

				{/* Right: Language Switcher + CTA */}
				<div class="flex items-center gap-3 md:gap-4">
					<slot name="language-switcher" />
					<a
						href={`/${currentLocale}/collaborate`}
						class="hidden sm:inline-flex bg-secondary text-on-secondary font-label-bold text-label-bold uppercase px-5 py-2.5 rounded-lg hover:brightness-110 transition-all duration-300 shadow-lg shadow-secondary/20"
					>
						{tr("nav.collaborate")}
					</a>
				</div>

				{/* Mobile hamburger — kept minimal for now, use slot for custom implementations */}
				<button
					id="mobile-menu-toggle"
					class="md:hidden flex items-center justify-center w-10 h-10 text-on-surface hover:text-secondary transition-colors"
					aria-label="Toggle navigation menu"
					type="button"
				>
					<span class="material-symbols-outlined text-2xl">menu</span>
				</button>
			</div>

			{/* Mobile navigation drawer — hidden by default, toggled via script */}
			<nav
				id="mobile-nav"
				class="md:hidden absolute top-full left-0 right-0 glass-panel border-t border-outline-variant/30 hidden flex-col items-stretch px-margin-mobile py-md gap-2"
			>
				<a
					href={`/${currentLocale}/travels`}
					class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300 px-4 py-3 rounded-lg hover:bg-surface-container-high"
				>
					{tr("nav.travels")}
				</a>
				<a
					href={`/${currentLocale}/journal`}
					class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300 px-4 py-3 rounded-lg hover:bg-surface-container-high"
				>
					{tr("nav.journal")}
				</a>
				<a
					href={`/${currentLocale}/about`}
					class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300 px-4 py-3 rounded-lg hover:bg-surface-container-high"
				>
					{tr("nav.about")}
				</a>
				<a
					href={`/${currentLocale}/collaborate`}
					class="font-label-bold text-label-bold uppercase bg-secondary text-on-secondary px-4 py-3 rounded-lg text-center hover:brightness-110 transition-all"
				>
					{tr("nav.collaborate")}
				</a>
				<a
					href={`/${currentLocale}/merch`}
					class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300 px-4 py-3 rounded-lg hover:bg-surface-container-high"
				>
					{tr("nav.merch")}
				</a>
				<a
					href={`/${currentLocale}/trainings`}
					class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300 px-4 py-3 rounded-lg hover:bg-surface-container-high"
				>
					{tr("nav.trainings")}
				</a>
				<a
					href={`/${currentLocale}/pictures`}
					class="font-label-bold text-label-bold uppercase text-on-surface-variant hover:text-secondary transition-colors duration-300 px-4 py-3 rounded-lg hover:bg-surface-container-high"
				>
					{tr("nav.pictures")}
				</a>
				<div class="pt-2 border-t border-outline-variant/30 mt-2">
					<slot name="language-switcher-mobile" />
				</div>
			</nav>
		</header>

		{/* ==============================
					MAIN CONTENT
		============================== */}
		<main class="flex-grow pt-20">
			<slot />
		</main>

		{/* ==============================
					FOOTER
		============================== */}
		<footer>
			{/* --- Instagram CTA Section --- */}
			<section class="bg-surface-container py-xxl md:py-xxl lg:py-xxl">
				<div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop text-center">
					<h2 class="font-heading text-headline-xl text-on-surface mb-sm">
						{tr("instagram.title")}
					</h2>
					<p class="text-body-xl text-on-surface-variant max-w-2xl mx-auto mb-lg">
						{tr("instagram.subtitle")}
					</p>
					<a
						href="https://www.instagram.com/_micklas_/"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 bg-secondary text-on-secondary font-label-bold text-label-bold uppercase px-8 py-4 rounded-lg hover:brightness-110 transition-all duration-300 shadow-lg shadow-secondary/20"
					>
						<span class="material-symbols-outlined text-xl">photo_camera</span>
						{tr("instagram.follow")}
					</a>
				</div>
			</section>

			{/* --- Bottom Footer --- */}
			<section class="bg-surface-container-lowest py-xl md:py-xxl">
				<div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop">
					{/* 4-Column Grid (Desktop) */}
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-lg lg:gap-xl pb-lg lg:pb-xl border-b border-outline-variant/20">
						{/* Column 1: Brand */}
						<div class="space-y-md">
							<div class="flex items-center gap-3">
								<img
									src="/logo-micklas.jpg"
									alt="Micklas Travels"
									class="h-10 w-10 rounded-full"
								/>
								<span class="font-heading text-headline-lg-mobile text-on-surface font-semibold">
									Micklas Travels
								</span>
							</div>
							<p class="text-body-md text-on-surface-variant leading-relaxed">
								{tr("footer.tagline")}
							</p>
						</div>

						{/* Column 2: Navigation */}
						<div class="space-y-md">
							<h3 class="font-label-bold text-label-bold uppercase text-outline-variant">
								{currentLocale === "de" ? "Navigation" : "Navigation"}
							</h3>
							<ul class="space-y-2">
								<li>
									<a href={`/${currentLocale}/travels`} class="text-on-surface-variant hover:text-secondary transition-colors duration-300">
										{tr("nav.travels")}
									</a>
								</li>
								<li>
									<a href={`/${currentLocale}/journal`} class="text-on-surface-variant hover:text-secondary transition-colors duration-300">
										{tr("nav.journal")}
									</a>
								</li>
								<li>
									<a href={`/${currentLocale}/about`} class="text-on-surface-variant hover:text-secondary transition-colors duration-300">
										{tr("nav.about")}
									</a>
								</li>
								<li>
									<a href={`/${currentLocale}/collaborate`} class="text-on-surface-variant hover:text-secondary transition-colors duration-300">
										{tr("nav.collaborate")}
									</a>
								</li>
								<li>
									<a href={`/${currentLocale}/merch`} class="text-on-surface-variant hover:text-secondary transition-colors duration-300">
										{tr("nav.merch")}
									</a>
								</li>
								<li>
									<a href={`/${currentLocale}/trainings`} class="text-on-surface-variant hover:text-secondary transition-colors duration-300">
										{tr("nav.trainings")}
									</a>
								</li>
								<li>
									<a href={`/${currentLocale}/pictures`} class="text-on-surface-variant hover:text-secondary transition-colors duration-300">
										{tr("nav.pictures")}
									</a>
								</li>
							</ul>
						</div>

						{/* Column 3: Legal */}
						<div class="space-y-md">
							<h3 class="font-label-bold text-label-bold uppercase text-outline-variant">
								{currentLocale === "de" ? "Rechtliches" : "Legal"}
							</h3>
							<ul class="space-y-2">
								<li>
									<a href={`/${currentLocale}/impressum`} class="text-on-surface-variant hover:text-secondary transition-colors duration-300">
										{tr("nav.impressum")}
									</a>
								</li>
								<li>
									<a href={`/${currentLocale}/privacy`} class="text-on-surface-variant hover:text-secondary transition-colors duration-300">
										{tr("nav.privacy")}
									</a>
								</li>
							</ul>
						</div>

						{/* Column 4: Social + Contact */}
						<div class="space-y-md">
							<h3 class="font-label-bold text-label-bold uppercase text-outline-variant">
								{currentLocale === "de" ? "Social" : "Social"}
							</h3>
							<ul class="space-y-2">
								<li>
									<a
										href="https://www.instagram.com/_micklas_/"
										target="_blank"
										rel="noopener noreferrer"
										class="flex items-center gap-2 text-on-surface-variant hover:text-secondary transition-colors duration-300"
									>
										<span class="material-symbols-outlined text-lg">photo_camera</span>
										Instagram / @_micklas_
									</a>
								</li>
								<li>
									<a
										href="mailto:hello@micklas.travel"
										class="flex items-center gap-2 text-on-surface-variant hover:text-secondary transition-colors duration-300"
									>
										<span class="material-symbols-outlined text-lg">mail</span>
										hello@micklas.travel
									</a>
								</li>
							</ul>
						</div>
					</div>

					{/* Copyright bar */}
					<div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-lg text-sm text-on-surface-variant">
						<p>&copy; {year} Micklas Travels. {tr("footer.rights")}</p>
						<p class="text-outline-variant text-label-sm">
							{tr("footer.tagline")}
						</p>
					</div>
				</div>
			</section>
		</footer>

		<!-- GDPR Cookie Consent Banner -->
		<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[100] glass-panel border-t border-outline-variant/20 p-lg hidden">
			<div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-md">
				<div class="flex-1">
					<p class="font-body-md text-body-md text-on-surface mb-xs font-semibold">Cookie Einstellungen</p>
					<p class="font-body-md text-body-md text-on-surface-variant text-sm">
						Diese Website verwendet nur technisch notwendige Cookies. Keine Tracking-Cookies, keine Analyse-Cookies.
						<span class="block sm:inline">This site uses only essential cookies. No tracking, no analytics cookies.</span>
					</p>
				</div>
				<div class="flex gap-sm shrink-0">
					<button id="cookie-accept" class="bg-secondary text-on-secondary font-label-bold text-label-bold uppercase px-6 py-3 rounded-lg hover:brightness-110 transition-all">
						Akzeptieren / Accept
					</button>
					<button id="cookie-decline" class="border border-outline-variant text-on-surface-variant font-label-bold text-label-bold uppercase px-6 py-3 rounded-lg hover:bg-surface-container-high transition-all">
						Schließen / Close
					</button>
				</div>
			</div>
		</div>

		{/* ==============================
					SCRIPTS
		============================== */
		<script>
			// Mobile navigation toggle
			const toggleBtn = document.getElementById("mobile-menu-toggle");
			const mobileNav = document.getElementById("mobile-nav");

			if (toggleBtn && mobileNav) {
				toggleBtn.addEventListener("click", () => {
					const isHidden = mobileNav.classList.contains("hidden");
					mobileNav.classList.toggle("hidden", !isHidden);
					mobileNav.classList.toggle("flex", isHidden);

					// Update aria-label and icon
					const icon = toggleBtn.querySelector(".material-symbols-outlined");
					if (icon) {
						icon.textContent = isHidden ? "close" : "menu";
					}
					toggleBtn.setAttribute("aria-expanded", String(isHidden));
				});

				// Close mobile nav when clicking a link inside it
				mobileNav.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", () => {
						mobileNav.classList.add("hidden");
						mobileNav.classList.remove("flex");
						const icon = toggleBtn.querySelector(".material-symbols-outlined");
						if (icon) icon.textContent = "menu";
						toggleBtn.setAttribute("aria-expanded", "false");
					});
				});
			}

			// GDPR Cookie Consent
			(function() {
				const banner = document.getElementById("cookie-banner");
				const acceptBtn = document.getElementById("cookie-accept");
				const declineBtn = document.getElementById("cookie-decline");
				
				if (banner && !localStorage.getItem("cookie-consent")) {
					banner.classList.remove("hidden");
				}
				
				function handleConsent() {
					localStorage.setItem("cookie-consent", "accepted");
					banner.classList.add("hidden");
				}
				
				if (acceptBtn) acceptBtn.addEventListener("click", handleConsent);
				if (declineBtn) declineBtn.addEventListener("click", handleConsent);
			})();

			// Scroll reveal observer
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("visible");
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
			);

			// Observe all .reveal elements once DOM is ready
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", () => {
					document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
				});
			} else {
				document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
			}
		</script>
	</body>
</html>

<style is:global>
	@import "tailwindcss";

	/* ==============================
			 DESIGN SYSTEM THEME TOKENS
	============================== */
	@theme {
		/* --- Colors (Material 3 inspired dark palette) --- */
		--color-surface: #121317;
		--color-surface-dim: #121317;
		--color-surface-bright: #38393d;
		--color-surface-container-lowest: #0d0e12;
		--color-surface-container-low: #1b1b1f;
		--color-surface-container: #1f1f24;
		--color-surface-container-high: #292a2e;
		--color-surface-container-highest: #343439;
		--color-on-surface: #e3e2e7;
		--color-on-surface-variant: #c5c6d1;
		--color-primary: #b5c4ff;
		--color-on-primary: #172c66;
		--color-primary-container: #142a64;
		--color-on-primary-container: #8093d3;
		--color-secondary: #5adcb9;
		--color-on-secondary: #00382c;
		--color-secondary-container: #00a787;
		--color-on-secondary-container: #003328;
		--color-tertiary: #ffb690;
		--color-error: #ffb4ab;
		--color-outline: #8f909b;
		--color-outline-variant: #444650;
		--color-background: #121317;
		--color-on-background: #e3e2e7;

		/* --- Font Families --- */
		--font-heading: "Playfair Display", serif;
		--font-body: "Inter", sans-serif;

		/* --- Typography: Display --- */
		--text-display-lg: 64px;
		--text-display-lg--line-height: 72px;
		--text-display-lg--font-weight: 700;
		--text-display-lg--letter-spacing: -0.02em;

		/* --- Typography: Headlines --- */
		--text-headline-xl: 48px;
		--text-headline-xl--line-height: 56px;
		--text-headline-xl--font-weight: 700;

		--text-headline-lg: 32px;
		--text-headline-lg--line-height: 40px;
		--text-headline-lg--font-weight: 600;

		--text-headline-lg-mobile: 28px;
		--text-headline-lg-mobile--line-height: 36px;
		--text-headline-lg-mobile--font-weight: 600;

		/* --- Typography: Body --- */
		--text-body-xl: 20px;
		--text-body-xl--line-height: 32px;
		--text-body-xl--font-weight: 400;

		--text-body-md: 16px;
		--text-body-md--line-height: 24px;
		--text-body-md--font-weight: 400;

		/* --- Typography: Labels --- */
		--text-label-bold: 14px;
		--text-label-bold--line-height: 20px;
		--text-label-bold--font-weight: 600;
		--text-label-bold--letter-spacing: 0.05em;

		--text-label-sm: 12px;
		--text-label-sm--line-height: 16px;
		--text-label-sm--font-weight: 500;

		/* --- Custom Spacing --- */
		--spacing-base: 4px;
