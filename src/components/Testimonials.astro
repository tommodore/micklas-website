---
import { t, getLocale } from "../i18n/translations";
import testimonials from "../data/testimonials";

interface Props {
	locale: string;
}

const { locale } = Astro.props;
const _ = (key: string) => t(key, getLocale(locale));
---

<section class="bg-gray-50 py-24 reveal">
	<div class="max-w-6xl mx-auto px-6">
		<div class="text-center mb-16">
			<div class="inline-block px-4 py-1 bg-brand-teal/10 text-brand-teal text-sm tracking-[3px] mb-4">
				{_("testimonials.badge")}
			</div>
			<h2 class="text-5xl font-bold tracking-tight">{_("testimonials.title")}</h2>
		</div>

		<div class="grid md:grid-cols-3 gap-8">
			{testimonials.map((testimonial) => (
				<div class="bg-white p-10 rounded-3xl border border-gray-100">
					<div class="flex mb-6">
						{[...Array(5)].map((_, i) => (
							<span class="text-brand-teal text-xl">★</span>
						))}
					</div>
					<blockquote class="text-lg leading-relaxed text-gray-700 mb-8">
						&ldquo;{testimonial.quote}&rdquo;
					</blockquote>
					<div class="flex items-center gap-4">
						<div class="w-14 h-14 rounded-full bg-brand-teal/20 flex items-center justify-center text-brand-teal font-bold text-xl">
							{testimonial.name.charAt(0)}
						</div>
						<div>
							<div class="font-semibold">{testimonial.name}</div>
							<div class="text-sm text-gray-500">{testimonial.role}</div>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
