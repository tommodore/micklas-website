---
import { t, getLocale } from "../i18n/translations";
import testimonials from "../data/testimonials";

interface Props {
	locale: string;
}

const { locale } = Astro.props;
const tr = (key: string) => t(key, getLocale(locale));
---

<section class="py-xxl px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto reveal">
	<div class="text-center mb-xl">
		<h2 class="font-headline-xl text-headline-xl text-on-surface mb-sm">{tr("testimonials.title")}</h2>
	</div>

	<div class="grid md:grid-cols-3 gap-gutter">
		{testimonials.map((testimonial) => (
			<div class="glass-panel rounded-xl p-lg flex flex-col gap-md">
				<div class="flex gap-xs">
					{[...Array(5)].map((_, i) => (
						<span class="text-secondary text-sm">★</span>
					))}
				</div>
				<blockquote class="font-body-md text-body-md text-on-surface-variant leading-relaxed flex-1">
					&ldquo;{testimonial.quote}&rdquo;
				</blockquote>
				<div class="flex items-center gap-sm pt-sm border-t border-outline-variant/10">
					<div class="w-12 h-12 rounded-full bg-secondary/20 flex items-center justify-center text-secondary font-bold font-headline-lg-mobile">
						{testimonial.name.charAt(0)}
					</div>
					<div>
						<div class="font-label-bold text-label-bold text-on-surface">{testimonial.name}</div>
						<div class="font-label-sm text-label-sm text-on-surface-variant">{testimonial.role}</div>
					</div>
				</div>
			</div>
		))}
	</div>
</section>
