---
import { t, getLocale } from "../i18n/translations";

interface Props {
	locale: string;
}

const { locale } = Astro.props;
const tr = (key: string) => t(key, getLocale(locale));

const destinations = [
	{
		slug: "iceland",
		title: "Iceland",
		subtitle: "The Land of Fire and Ice",
		image: "https://lh3.googleusercontent.com/aida-public/AB6AXuAtUQwWIUsGhGPbXHskZ-N2GeBsLL-xo3v1o5uyoH2d_9pRDJK0LCDzYKkvWvq6Kv_G64UfIBGYO64214J7v40GPat-4JTxjOQbaZYih_jdNpq7kyzSfSFwMjbyDX8KeEe9dvGaBiM4MjMNaPaOk9hYnlU5ldsLeoC9MxQhZgqfDH1s9Vz5gMOyn2WZw1DL9UaCxz3KOHQysiIRvSPJRzdnPDyF0-G_mFGcn5gPAL1qHF8SeAAI-nmYifij0QNK5obzIcQskYJMlBxo",
		tag: "Adventure",
	},
	{
		slug: "bali",
		title: "Bali",
		subtitle: "Tropical Serenity & Culture",
		image: "https://lh3.googleusercontent.com/aida-public/AB6AXuBII5cmm6NpJ4G13DBFvjzLd27smjG_bHwhi-cHWGdioNwh-40Cg03C7z-rUu4ItiaiWfRbjPg1kfqichj1Mtq1TlhF_fJCV-Am_iZLTCWe7yUXUzAKa57zMh1ZhWTM1HJv2zoz5ogP5DOxD0jiFoPC9maBGPMhhYZm_JD3zOkZx0uRkP4gjF4ic7kWtPPQrsfN2E_D4x8t38CrKfYt-uooJO2Roo-7ur6CstJjjIVB-zf7rCdAocrZizsVdz0O8xJmiOsmxtoIYQ82",
		tag: "Luxury",
	},
	{
		slug: "amalfi",
		title: "Amalfi Coast",
		subtitle: "Mediterranean Elegance",
		image: "https://lh3.googleusercontent.com/aida-public/AB6AXuAaeukhpldN4cIiLAq_PxLtYymheJ5pvzIAUmFmFqcXE5D1gGewap5gbWuapcDdXp14gUmEe59n-x291mK8jhE6th6M2C2a4QzQnHySNu-bpES7tQZ1WuDehbH6XN2rTRivR5K15LQZjTmgEfZfYyggmy05po-cY338tE1qIdjOJZAWvC19ikpF0MacMoaZcAxeOLErPMPiG-AzMPCmxuijFzcIAqQ7vrfi-FMsM8pASO5uRPC9yDwLA-eU96bMmkZZt9idoFLjcI15",
		tag: "Nature",
	},
];
---

<section class="py-xxl px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto reveal">
	<div class="flex flex-col md:flex-row justify-between items-end mb-xl gap-sm">
		<div>
			<h2 class="font-headline-xl text-headline-xl text-on-surface mb-sm">{tr("featured.title")}</h2>
			<p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">{tr("featured.subtitle")}</p>
		</div>
		<div class="flex gap-4">
			{destinations.map((dest) => (
				<button class="px-4 py-2 rounded-full border border-secondary text-secondary font-label-bold text-label-bold hover:bg-secondary/10 transition-colors">
					{dest.tag}
				</button>
			))}
		</div>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
		{destinations.map((dest) => (
			<a
				href={`/${locale}/travels`}
				class="group relative rounded-xl overflow-hidden aspect-[4/5] cursor-pointer block"
			>
				<img
					src={dest.image}
					alt={dest.title}
					class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
				/>
				<div class="absolute inset-0 cinematic-overlay flex flex-col justify-end p-lg">
					<h3 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-white mb-xs">{dest.title}</h3>
					<p class="font-body-md text-body-md text-on-surface-variant mb-md opacity-0 group-hover:opacity-100 transition-opacity duration-300">{dest.subtitle}</p>
					<span class="inline-flex items-center gap-2 text-secondary font-label-bold text-label-bold hover:text-secondary-fixed transition-colors">
						{tr("featured.read")} <span class="material-symbols-outlined text-sm">arrow_forward</span>
					</span>
				</div>
			</a>
		))}
	</div>
</section>
