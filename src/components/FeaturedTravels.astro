---
import { t, getLocale } from "../i18n/translations";

interface Props {
	locale: string;
}

const { locale } = Astro.props;
const _ = (key: string) => t(key, getLocale(locale));

const featuredDestinations = [
	{
		slug: "lofoten-norway",
		title: "Lofoten Islands",
		country: "Norway",
		year: "2026",
		description: "Breathtaking fjords, dramatic mountains, and the magical Northern Lights.",
	},
	{
		slug: "patagonia-chile",
		title: "Torres del Paine",
		country: "Chile",
		year: "2026",
		description: "Epic granite towers and endless wilderness in Patagonia.",
	},
	{
		slug: "iceland-winter",
		title: "Iceland Winter",
		country: "Iceland",
		year: "2025",
		description: "Northern Lights and ice caves in the land of fire and ice.",
	},
];
---

<section class="max-w-6xl mx-auto px-6 py-24 reveal">
	<div class="text-center mb-16">
		<div class="inline-block px-4 py-1 bg-brand-teal/10 text-brand-teal text-sm tracking-widest mb-4">
			{_("featured.badge")}
		</div>
		<h2 class="text-5xl font-bold tracking-tight">{_("featured.title")}</h2>
		<p class="mt-4 text-xl text-gray-600 max-w-md mx-auto">
			{_("featured.subtitle")}
		</p>
	</div>

	<div class="grid md:grid-cols-3 gap-8">
		{featuredDestinations.map((dest) => (
			<a
				href={`/${locale}/travels`}
				class="group block overflow-hidden rounded-2xl border border-gray-100 hover:shadow-xl transition-all"
			>
				<div class="h-80 bg-gradient-to-br from-brand-navy/70 to-brand-navy relative">
					<div class="absolute inset-0 bg-gradient-to-b from-black/30 to-black/60"></div>
					<div class="absolute bottom-6 left-6 text-white">
						<div class="text-sm opacity-75">{dest.country.toUpperCase()} &bull; {dest.year}</div>
						<div class="text-3xl font-semibold">{dest.title}</div>
					</div>
				</div>
				<div class="p-6">
					<p class="text-gray-600 line-clamp-3">{dest.description}</p>
					<div class="mt-4 text-brand-teal font-medium group-hover:underline">
						{_("featured.read")}
					</div>
				</div>
			</a>
		))}
	</div>

	<div class="text-center mt-12">
		<a
			href={`/${locale}/travels`}
			class="inline-flex items-center text-lg font-medium text-brand-teal hover:underline"
		>
			{_("featured.all")}
		</a>
	</div>
</section>
