---
const languages = [
	{ code: "de", label: "Deutsch" },
	{ code: "en", label: "English" },
	{ code: "fr", label: "Français" },
	{ code: "it", label: "Italiano" },
	{ code: "es", label: "Español" },
	{ code: "pt", label: "Português" },
	{ code: "da", label: "Dansk" },
	{ code: "sv", label: "Svenska" },
	{ code: "no", label: "Norsk" },
	{ code: "me", label: "Crnogorski" },
];

const currentLocale = Astro.currentLocale || "de";
const currentPath = Astro.url.pathname;
---

<div class="flex items-center gap-1 text-sm">
	{languages.map((lang) => {
		// Replace the current locale prefix with this locale's prefix
		const href = currentPath.replace(
			new RegExp(`^/${currentLocale}(/|$)`),
			`/${lang.code}$1`,
		).replace(/\/$/, "") || `/${lang.code}`;

		return (
			<a
				href={href}
				class={`px-2 py-1 rounded transition-all ${
					currentLocale === lang.code
						? "bg-brand-teal text-white font-medium"
						: "hover:bg-gray-100 text-gray-600"
				}`}
			>
				{lang.label}
			</a>
		);
	})}
</div>
