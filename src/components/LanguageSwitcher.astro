---
interface Props {
	mobile?: boolean;
}

const languages = [
	{ code: "de", label: "Deutsch" },
	{ code: "en", label: "English" },
	{ code: "fr", label: "Français" },
	{ code: "it", label: "Italiano" },
	{ code: "es", label: "Español" },
	{ code: "pt", label: "Português" },
	{ code: "da", label: "Dansk" },
	{ code: "sv", label: "Svenska" },
	{ code: "no", label: "Norsk" },
	{ code: "me", label: "Crnogorski" },
];

const currentLocale = Astro.currentLocale || "de";
const currentPath = Astro.url.pathname;
const { mobile } = Astro.props;
---

{
	mobile ? (
		// Mobile: flat list of language links (no dropdown)
		<div class="flex flex-col gap-1">
			<span class="font-label-bold text-label-bold uppercase text-outline-variant px-4 py-2">{currentLocale === "de" ? "Sprache" : "Language"}</span>
			{languages.map((lang) => {
				const href = currentPath.replace(
					new RegExp(`^/${currentLocale}(/|$)`),
					`/${lang.code}$1`,
				).replace(/\/$/, "") || `/${lang.code}`;

				return (
					<a
						href={href}
						class={`block px-4 py-3 rounded-lg font-body-md text-body-md transition-colors ${
							currentLocale === lang.code
								? "bg-secondary/20 text-secondary font-label-bold"
								: "text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high"
						}`}
					>
						{lang.label}
					</a>
				);
			})}
		</div>
	) : (
		// Desktop: click-toggle dropdown
		<div id="language-switcher" class="relative">
			<button
				id="lang-toggle"
				class="flex items-center gap-1 font-label-bold text-label-bold text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer"
				aria-label="Switch language"
				type="button"
			>
				<span class="material-symbols-outlined text-base">translate</span>
				<span class="hidden md:inline">{languages.find(l => l.code === currentLocale)?.label || currentLocale}</span>
				<span class="material-symbols-outlined text-sm hidden md:inline transition-transform duration-200">expand_more</span>
			</button>
			<div
				id="lang-dropdown"
				class="absolute right-0 top-full mt-2 glass-panel rounded-xl p-sm min-w-[200px] hidden z-50"
			>
				{languages.map((lang) => {
					const href = currentPath.replace(
						new RegExp(`^/${currentLocale}(/|$)`),
						`/${lang.code}$1`,
					).replace(/\/$/, "") || `/${lang.code}`;

					return (
						<a
							href={href}
							class={`block px-sm py-xs rounded-lg font-body-md text-body-md transition-colors ${
								currentLocale === lang.code
									? "bg-secondary/20 text-secondary font-label-bold"
									: "text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high"
							}`}
						>
							{lang.label}
						</a>
					);
				})}
			</div>
		</div>
	)
}

<script>
	// Click-toggle for language switcher dropdown (works on mobile + desktop)
	const container = document.getElementById("language-switcher");
	const toggle = document.getElementById("lang-toggle");
	const dropdown = document.getElementById("lang-dropdown");

	if (toggle && dropdown && container) {
		toggle.addEventListener("click", (e) => {
			e.stopPropagation();
			dropdown.classList.toggle("hidden");
		});

		// Close when clicking outside
		document.addEventListener("click", (e) => {
			if (!container.contains(e.target)) {
				dropdown.classList.add("hidden");
			}
		});

		// Close on Escape key
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") {
				dropdown.classList.add("hidden");
			}
		});
	}
</script>
