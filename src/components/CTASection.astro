---
import { t, getLocale } from "../i18n/translations";

interface Props {
	locale: string;
}

const { locale } = Astro.props;
const tr = (key: string) => t(key, getLocale(locale));
---

<section class="py-xxl px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto text-center reveal">
	<h2 class="font-headline-xl text-headline-xl text-on-surface mb-sm">{tr("cta.title")}</h2>
	<p class="font-body-xl text-body-xl text-on-surface-variant mb-xl max-w-xl mx-auto">
		{tr("cta.description")}
	</p>
	<a
		href={`/${locale}/collaborate`}
		class="inline-block bg-secondary text-on-secondary px-8 py-4 rounded-lg font-label-bold text-label-bold hover:bg-secondary-fixed transition-colors shadow-lg shadow-secondary/20"
	>
		{tr("cta.button")}
	</a>
</section>
