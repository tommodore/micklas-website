---
import { t, getLocale } from "../i18n/translations";

interface Props {
	locale: string;
}

const { locale } = Astro.props;
const tr = (key: string) => t(key, getLocale(locale));
---

<section class="bg-brand-navy text-white py-24 reveal">
	<div class="max-w-3xl mx-auto text-center px-6">
		<h2 class="text-5xl font-bold tracking-tight mb-6">{tr("cta.title")}</h2>
		<p class="text-xl text-white/80 mb-10 max-w-lg mx-auto">
			{tr("cta.description")}
		</p>
		<a
			href={`/${locale}/collaborate`}
			class="inline-block bg-brand-teal hover:bg-white hover:text-brand-navy text-white text-lg px-14 py-4 rounded-full font-medium transition-all"
		>
			{tr("cta.button")}
		</a>
	</div>
</section>
