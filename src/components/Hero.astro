---
import { t, getLocale } from "../i18n/translations";
import { getAllLocales } from "../i18n/locales";

interface Props {
	locale: string;
}

const { locale } = Astro.props;
const tr = (key: string) => t(key, getLocale(locale));
const locales = getAllLocales();
---

<section class="relative h-[90vh] min-h-[600px] w-full flex items-center justify-center overflow-hidden">
	<div class="absolute inset-0 z-0">
		<img
			src="https://lh3.googleusercontent.com/aida-public/AB6AXuAvuppMDaUDJLENPq8-FbhYNI3cq1H8E5LYyF3gRiE_VR602gr4JRMoOVlv0N4KNe53TETdWNxNgdNTMzJEmp6r1YSVAbwiGaKNuS6exNoFpDstMxkRdXvZszc5kKFmM0HQf5xD5mXZADfV2ZlOX8yM8huZI0sueVSJevaE6cmaIZ6M7N7bTGfMEw2jzZR1fhXgjyF4XcA0YqlY-YYoyoMz4ySrpCTGQ1al9_kEYS9SjP9veDfJ0H94rgysF5E3W9ctaeFK-ZepyIvn"
			alt="Cinematic Hero Background"
			class="w-full h-full object-cover"
		/>
		<div class="absolute inset-0 cinematic-overlay"></div>
	</div>

	<div class="relative z-10 flex flex-col items-center text-center px-margin-mobile md:px-margin-desktop max-w-4xl mx-auto mt-16">
		<div class="w-48 h-48 md:w-64 md:h-64 mb-lg rounded-full overflow-hidden border-4 border-surface/20 shadow-2xl glass-panel p-2 hero-fade-in">
			<img
				src="/logo-micklas.jpg"
				alt="Micklas Travels Logo"
				class="w-full h-full object-contain rounded-full"
			/>
		</div>

		<h1 class="font-display-lg text-display-lg text-white mb-sm hero-fade-in-delay-1">
			{tr("hero.title")}
		</h1>

		<p class="font-body-xl text-body-xl text-on-surface-variant mb-xl max-w-2xl hero-fade-in-delay-2">
			{tr("hero.subtitle")}
		</p>

		<a
			href={`/${locale}/collaborate`}
			class="bg-secondary text-on-secondary px-8 py-4 rounded-lg font-label-bold text-label-bold text-lg hover:bg-secondary-fixed transition-colors shadow-lg shadow-secondary/20 hero-fade-in-delay-2"
		>
			{tr("hero.cta.collaborate")}
		</a>
	</div>
</section>
