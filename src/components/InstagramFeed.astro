---

<section class="bg-surface-container py-xxl reveal">
	<div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop">
		<div class="flex flex-col md:flex-row justify-between items-center mb-xl gap-sm">
			<div class="text-center md:text-left">
				<h2 class="font-headline-xl text-headline-xl text-on-surface mb-xs">{tr("instagram.title")}</h2>
				<p class="font-body-xl text-body-xl text-on-surface-variant">{tr("instagram.subtitle")}</p>
			</div>
			<a
				href="https://instagram.com/_micklas_"
				target="_blank"
				class="flex items-center gap-2 bg-secondary text-on-secondary px-8 py-3 rounded-lg font-label-bold text-label-bold hover:bg-secondary-fixed transition-colors shadow-lg shadow-secondary/10"
			>
				<span class="material-symbols-outlined">photo_camera</span>
				{tr("instagram.follow")}
			</a>
		</div>

		<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
			{images.map((img, i) => (
				<a
					href="https://instagram.com/_micklas_"
					target="_blank"
					class="aspect-square overflow-hidden rounded-lg group"
				>
					<img
						src={img}
						alt={`Instagram ${i + 1}`}
						class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
					/>
				</a>
			))}
		</div>
	</div>
</section>
