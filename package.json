{
	"name": "micklas-website",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently \"next dev --port 3000\" \"astro dev --port 4321\"",
		"dev:payload": "next dev --port 3000",
		"dev:astro": "astro dev --port 4321",
		"build": "astro build",
		"build:payload": "bash build-payload.sh",
		"build:all": "npm run build:payload && npm run build",
		"preview:payload": "bash deploy-payload.sh --preview",
		"deploy:payload": "bash deploy-payload.sh",
		"preview": "astro build && wrangler pages dev",
		"deploy": "astro build && wrangler pages deploy",
		"deploy:all": "npm run deploy:payload && npm run deploy",
		"lint": "astro check",
		"payload:generate": "payload generate:types",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.5.4",
		"@astrojs/react": "^5.0.5",
		"@opennextjs/cloudflare": "1.19.11",
		"@payloadcms/db-d1-sqlite": "3.82.1",
		"@payloadcms/graphql": "3.82.1",
		"@payloadcms/next": "3.82.1",
		"@payloadcms/richtext-lexical": "3.82.1",
		"@payloadcms/storage-r2": "3.82.1",
		"astro": "^6.3.7",
		"framer-motion": "12.40.0",
		"graphql": "16.14.0",
		"lucide-react": "0.511.0",
		"next": "15.4.11",
		"payload": "3.82.1",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"sharp": "0.33.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "22.19.19",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3",
		"concurrently": "^9.2.1",
		"eslint": "9.39.4",
		"postcss": "8.5.15",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.9.3",
		"wrangler": "4.94.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"unrs-resolver",
			"workerd"
		]
	}
}
