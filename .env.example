# Payload Secret - generate a random string
PAYLOAD_SECRET=your-super-long-random-secret-here

# Astro public-facing URL (used to link to Payload API)
# In dev, Astro fetches from localhost:3000 (Next.js dev server for Payload)
# In production, set to the Payload Worker URL (e.g., https://admin.micklas.travel)
PUBLIC_PAYLOAD_URL=
